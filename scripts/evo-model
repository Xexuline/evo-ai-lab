#!/usr/bin/env bash
# Local named-instance model manager for llama.cpp.
set -euo pipefail

readonly PROGRAM=evo-model
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly INSTALLED_PROFILE_DIR="$HOME/.local/share/evo-model/models"
readonly REPOSITORY_PROFILE_DIR="$SCRIPT_DIR/../config/models"
if [[ -n ${EVO_MODEL_PROFILE_DIR+x} ]]; then
  PROFILE_DIR=$EVO_MODEL_PROFILE_DIR
elif [[ -d $INSTALLED_PROFILE_DIR ]]; then
  PROFILE_DIR=$INSTALLED_PROFILE_DIR
elif [[ -d $REPOSITORY_PROFILE_DIR ]]; then
  PROFILE_DIR=$REPOSITORY_PROFILE_DIR
else
  PROFILE_DIR=$INSTALLED_PROFILE_DIR
fi
readonly PROFILE_DIR
readonly STATE_DIR="${EVO_MODEL_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/evo-model}"
readonly LEGACY_SELECTION_FILE="$STATE_DIR/selected-profile"
readonly HEALTH_TIMEOUT="${EVO_MODEL_HEALTH_TIMEOUT:-180}"

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

note() {
  printf '%s\n' "$*"
}

usage() {
  cat <<'EOF'
Usage: evo-model <command> [arguments]

Instances: worker (port 8080), agent (port 8081).
  list
  status [instance] [--json]
  start [instance] <profile>
  stop [instance]
  restart [instance]
  logs [instance] [-f|--follow]
  --validate-profile <profile>
  --validate-runtime [instance] <profile>
  --check-port [instance] <profile>

Legacy start <profile>, stop, restart, logs [-f], and --check-port <profile>
operate on worker. Only evo-model@.service instances are managed.
EOF
}

valid_instance() {
  [[ $1 == worker || $1 == agent ]]
}

require_instance() {
  valid_instance "$1" || die "invalid instance: $1 (expected worker or agent)"
}

instance_port() {
  case $1 in
    worker) printf '8080\n' ;;
    agent) printf '8081\n' ;;
  esac
}

instance_container() {
  case $1 in
    worker) printf 'llama-vulkan-worker\n' ;;
    agent) printf 'llama-vulkan-radv\n' ;;
  esac
}

selection_file() {
  printf '%s/%s/selected-profile\n' "$STATE_DIR" "$1"
}

service_name() {
  printf 'evo-model@%s.service\n' "$1"
}

valid_key(){ case $1 in PROFILE_NAME|MODEL_PATH|BACKEND|CONTAINER|CONTEXT_SIZE|GPU_LAYERS|PARALLEL_SLOTS|SPEC_TYPE|DRAFT_MODEL_PATH|DRAFT_GPU_LAYERS|MMPROJ_PATH|SPEC_DRAFT_N_MAX|SPEC_DRAFT_P_MIN|HOST|PORT) return;; *) return 1;; esac; }
reset_profile(){ PROFILE_NAME= MODEL_PATH= BACKEND= CONTAINER= CONTEXT_SIZE= GPU_LAYERS= PARALLEL_SLOTS= SPEC_TYPE= DRAFT_MODEL_PATH= DRAFT_GPU_LAYERS= MMPROJ_PATH= SPEC_DRAFT_N_MAX= SPEC_DRAFT_P_MIN= HOST= PORT=; }
profile_path(){ [[ $1 =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid profile name: $1"; printf '%s/%s.conf\n' "$PROFILE_DIR" "$1"; }
load_profile(){ local profile=$1 file line key value n=0; file=$(profile_path "$profile"); [[ -f $file ]] || die "profile not found: $profile"; reset_profile; while IFS= read -r line || [[ -n $line ]]; do n=$((n+1)); [[ -z $line || $line == \#* ]] && continue; [[ $line == *=* ]] || die "$file:$n: expected KEY=VALUE"; key=${line%%=*}; value=${line#*=}; valid_key "$key" || die "$file:$n: unsupported key: $key"; [[ -n $value && ! $value =~ [[:cntrl:]] ]] || die "$file:$n: invalid or empty value"; [[ -z ${!key+x} || -z ${!key} ]] || die "$file:$n: duplicate key: $key"; printf -v "$key" '%s' "$value"; done < "$file"; [[ $PROFILE_NAME == "$profile" ]] || die "$file: PROFILE_NAME must equal filename ($profile)"; }
is_uint(){ [[ $1 =~ ^[0-9]+$ ]]; }; is_decimal_0_1(){ [[ $1 =~ ^(0|1|0\.[0-9]+|1\.0+)$ ]]; }; is_host(){ [[ $1 =~ ^[A-Za-z0-9.:_-]+$ ]]; }
validate_loaded_profile(){ local key; for key in PROFILE_NAME MODEL_PATH BACKEND CONTAINER CONTEXT_SIZE GPU_LAYERS PARALLEL_SLOTS SPEC_DRAFT_N_MAX SPEC_DRAFT_P_MIN HOST PORT; do [[ -n ${!key} ]] || die "profile $PROFILE_NAME: missing required key $key"; done; [[ $MODEL_PATH = /* && -f $MODEL_PATH ]] || die "profile $PROFILE_NAME: model not found or not absolute: $MODEL_PATH"; [[ -z $MMPROJ_PATH || ( $MMPROJ_PATH = /* && -f $MMPROJ_PATH ) ]] || die "profile $PROFILE_NAME: multimodal projector not found or not absolute: $MMPROJ_PATH"; if [[ -n $DRAFT_MODEL_PATH || -n $DRAFT_GPU_LAYERS ]]; then [[ -n $DRAFT_MODEL_PATH && -n $DRAFT_GPU_LAYERS && -n $SPEC_TYPE && $DRAFT_MODEL_PATH = /* && -f $DRAFT_MODEL_PATH ]] || die "profile $PROFILE_NAME: invalid external draft"; is_uint "$DRAFT_GPU_LAYERS" || die "profile $PROFILE_NAME: DRAFT_GPU_LAYERS must be a non-negative integer"; fi; [[ $CONTAINER =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "profile $PROFILE_NAME: invalid CONTAINER"; is_uint "$CONTEXT_SIZE" && [[ $CONTEXT_SIZE -gt 0 ]] || die "profile $PROFILE_NAME: invalid CONTEXT_SIZE"; is_uint "$GPU_LAYERS" || die "profile $PROFILE_NAME: invalid GPU_LAYERS"; is_uint "$PARALLEL_SLOTS" && [[ $PARALLEL_SLOTS -gt 0 ]] || die "profile $PROFILE_NAME: invalid PARALLEL_SLOTS"; [[ -z $SPEC_TYPE || $SPEC_TYPE =~ ^[A-Za-z0-9_-]+$ ]] || die "profile $PROFILE_NAME: invalid SPEC_TYPE"; is_uint "$SPEC_DRAFT_N_MAX" && is_decimal_0_1 "$SPEC_DRAFT_P_MIN" && is_host "$HOST" && is_uint "$PORT" && [[ $PORT -ge 1 && $PORT -le 65535 ]] || die "profile $PROFILE_NAME: invalid numeric, host, or port setting"; }
validate_runtime(){ local instance=$1 container; container=$(instance_container "$instance"); command -v distrobox >/dev/null 2>&1 || die "distrobox is not available"; distrobox list --no-color 2>/dev/null | awk -F '|' -v c="$container" 'function t(v){gsub(/^[[:space:]]+|[[:space:]]+$/, "",v);return v} {if(t($2)==c) found=1} END{exit !found}' || die "instance $instance: Distrobox container not found: $container"; }

migrate_legacy(){ local target selected; target=$(selection_file worker); [[ -f $target || ! -f $LEGACY_SELECTION_FILE ]] && return; IFS= read -r selected < "$LEGACY_SELECTION_FILE" || return; [[ $selected =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid saved selected profile"; mkdir -p "$(dirname "$target")"; umask 077; mv -- "$LEGACY_SELECTION_FILE" "$target"; }
read_selection(){ local instance=$1 selected file; require_instance "$instance"; [[ $instance == worker ]] && migrate_legacy; file=$(selection_file "$instance"); [[ -f $file ]] || return 1; IFS= read -r selected < "$file" || return 1; [[ $selected =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid saved selected profile for $instance"; printf '%s\n' "$selected"; }
save_selection(){ local file; file=$(selection_file "$1"); mkdir -p "$(dirname "$file")"; umask 077; printf '%s\n' "$2" > "$file"; }
service_active(){ systemctl --user is-active --quiet "$(service_name "$1")"; }
api_url(){ printf 'http://127.0.0.1:%s/v1/models\n' "$(instance_port "$1")"; }
ensure_port_available(){ local instance=$1 port listeners; port=$(instance_port "$instance"); command -v ss >/dev/null 2>&1 || die "ss is required to check whether port $port is available"; listeners=$(ss -ltnH "sport = :$port") || die "could not inspect port $port with ss"; if awk -v p="$port" '$4 ~ (":" p "$"){f=1} END{exit !f}' <<<"$listeners"; then die "port $port is already in use; stop the conflicting service or select a different instance"; fi; }
api_is_ready(){ local instance=$1 response name; service_active "$instance" || return; response=$(curl --fail --silent --max-time 5 "$(api_url "$instance")" 2>/dev/null) || return; name=${MODEL_PATH##*/}; [[ $response == *"\"$MODEL_PATH\""* || $response == *"\"$name\""* ]] && service_active "$instance"; }
wait_for_api(){ local instance=$1 start=$2 deadline=$((SECONDS+HEALTH_TIMEOUT)) elapsed; note "Loading $PROFILE_NAME for $instance..."; while ((SECONDS<deadline)); do service_active "$instance" || { printf 'Service failed before the API became ready. Inspect with: %s logs %s\n' "$PROGRAM" "$instance" >&2; return 1; }; if api_is_ready "$instance"; then elapsed=$((SECONDS-start)); note "Model loaded in ${elapsed}s"; note "API ready: $(api_url "$instance")"; return; fi; sleep 2; note "Waiting for API... $((SECONDS-start))s"; done; printf 'Model did not become ready after %ss. Inspect with: %s logs %s\n' "$((SECONDS-start))" "$PROGRAM" "$instance" >&2; return 1; }
with_lock(){ local instance=$1; shift; command -v flock >/dev/null 2>&1 || die "flock is required to serialize model changes"; mkdir -p "$STATE_DIR/$instance"; exec 9>"$STATE_DIR/$instance/manager.lock"; flock -n 9 || die "another evo-model operation for $instance is in progress"; "$@"; }

cmd_list() {
  local file profile worker agent selection

  worker=$(read_selection worker || true)
  agent=$(read_selection agent || true)
  shopt -s nullglob

  for file in "$PROFILE_DIR"/*.conf; do
    profile=${file##*/}
    profile=${profile%.conf}
    selection=

    [[ $profile == "$worker" ]] && selection=worker
    if [[ $profile == "$agent" ]]; then
      selection=${selection:+$selection,}agent
    fi

    if [[ -n $selection ]]; then
      printf '%-24s selected:%s\n' "$profile" "$selection"
    else
      printf '%s\n' "$profile"
    fi
  done
}
collect_status(){ local instance=$1; STATUS_INSTANCE=$instance; STATUS_CONTAINER=$(instance_container "$instance"); STATUS_PROFILE=$(read_selection "$instance" || true); STATUS_SERVICE=$(systemctl --user is-active "$(service_name "$instance")" 2>/dev/null || true); STATUS_SERVICE=${STATUS_SERVICE:-unknown}; STATUS_API=not-applicable; STATUS_BACKEND= STATUS_MODEL= STATUS_DRAFT_MODEL= STATUS_MMPROJ= STATUS_CONTEXT_TOTAL= STATUS_PARALLEL_SLOTS= STATUS_CONTEXT_PER_SLOT= STATUS_HOST= STATUS_PID=; STATUS_PORT=$(instance_port "$instance"); STATUS_LISTEN= STATUS_HEALTH_ENDPOINT=$(api_url "$instance"); [[ -n $STATUS_PROFILE ]] || return; load_profile "$STATUS_PROFILE"; validate_loaded_profile; STATUS_API=not-ready; api_is_ready "$instance" && STATUS_API=ready; STATUS_BACKEND=$BACKEND; STATUS_MODEL=$MODEL_PATH; STATUS_DRAFT_MODEL=$DRAFT_MODEL_PATH; STATUS_MMPROJ=$MMPROJ_PATH; STATUS_CONTEXT_TOTAL=$CONTEXT_SIZE; STATUS_PARALLEL_SLOTS=$PARALLEL_SLOTS; STATUS_CONTEXT_PER_SLOT=$((CONTEXT_SIZE / PARALLEL_SLOTS)); STATUS_HOST=$HOST; STATUS_LISTEN=$HOST:$STATUS_PORT; STATUS_PID=$(systemctl --user show --property=MainPID --value "$(service_name "$instance")" 2>/dev/null || true); [[ $STATUS_PID =~ ^[1-9][0-9]*$ ]] || STATUS_PID=; }
print_status(){ collect_status "$1"; printf 'Instance: %s\nProfile: %s\nService: %s\n' "$STATUS_INSTANCE" "${STATUS_PROFILE:-(none selected)}" "$STATUS_SERVICE"; [[ -n $STATUS_PROFILE ]] || { printf 'API: not applicable\nContainer: %s\n\n' "$STATUS_CONTAINER"; return; }; printf 'API: %s\nBackend: %s\nContainer: %s\nModel: %s\n' "$STATUS_API" "$STATUS_BACKEND" "$STATUS_CONTAINER" "$STATUS_MODEL"; [[ -n $STATUS_DRAFT_MODEL ]] && { local draft=${STATUS_DRAFT_MODEL##*/}; printf 'Draft model: %s\n' "$draft"; }; [[ -n $STATUS_MMPROJ ]] && { local mmproj=${STATUS_MMPROJ##*/}; printf 'MMProj: %s\n' "$mmproj"; }; printf 'Context: %s\nParallel slots: %s\nHost: %s\nPort: %s\nListen: %s\nHealth endpoint: %s\nPID: %s\n\n' "$STATUS_CONTEXT_TOTAL" "$STATUS_PARALLEL_SLOTS" "$STATUS_HOST" "$STATUS_PORT" "$STATUS_LISTEN" "$STATUS_HEALTH_ENDPOINT" "${STATUS_PID:--}"; }
json_string(){ local value=$1 char escaped= i; for ((i=0; i<${#value}; i++)); do char=${value:i:1}; case $char in '"') escaped+='\\"';; '\\') escaped+='\\\\';; $'\b') escaped+='\\b';; $'\f') escaped+='\\f';; $'\n') escaped+='\\n';; $'\r') escaped+='\\r';; $'\t') escaped+='\\t';; *) escaped+=$char;; esac; done; printf '"%s"' "$escaped"; }
json_value(){ [[ -n $1 ]] && json_string "$1" || printf 'null'; }
json_number_or_null(){ [[ -n $1 ]] && printf '%s' "$1" || printf 'null'; }
print_status_json_instance(){ collect_status "$1"; printf '    '; json_string "$STATUS_INSTANCE"; printf ': {\n'; printf '      "profile": '; json_value "$STATUS_PROFILE"; printf ',\n      "service": '; json_string "$STATUS_SERVICE"; printf ',\n      "api": '; json_string "$STATUS_API"; printf ',\n      "backend": '; json_value "$STATUS_BACKEND"; printf ',\n      "container": '; json_string "$STATUS_CONTAINER"; printf ',\n      "model": '; json_value "$STATUS_MODEL"; printf ',\n      "draft_model": '; json_value "$STATUS_DRAFT_MODEL"; printf ',\n      "mmproj": '; json_value "$STATUS_MMPROJ"; printf ',\n      "context_total": '; json_number_or_null "$STATUS_CONTEXT_TOTAL"; printf ',\n      "parallel_slots": '; json_number_or_null "$STATUS_PARALLEL_SLOTS"; printf ',\n      "context_per_slot": '; json_number_or_null "$STATUS_CONTEXT_PER_SLOT"; printf ',\n      "host": '; json_value "$STATUS_HOST"; printf ',\n      "port": %s,\n' "$STATUS_PORT"; printf '      "listen": '; json_value "$STATUS_LISTEN"; printf ',\n      "health_endpoint": '; json_string "$STATUS_HEALTH_ENDPOINT"; printf ',\n      "pid": '; json_number_or_null "$STATUS_PID"; printf '\n    }'; }
cmd_status(){ local json= instance=; case $# in 0) ;; 1) case $1 in --json) json=1;; worker|agent) instance=$1;; *) die "usage: $PROGRAM status [instance] [--json]";; esac;; 2) require_instance "$1"; [[ $2 == --json ]] || die "usage: $PROGRAM status [instance] [--json]"; instance=$1; json=1;; *) die "usage: $PROGRAM status [instance] [--json]";; esac; if [[ -n $json ]]; then printf '{\n  "instances": {\n'; if [[ -n $instance ]]; then print_status_json_instance "$instance"; else print_status_json_instance worker; printf ',\n'; print_status_json_instance agent; fi; printf '\n  }\n}\n'; elif [[ -n $instance ]]; then print_status "$instance"; else print_status worker; print_status agent; fi; }
start_selected(){ local instance=$1 profile=$2 start; load_profile "$profile"; validate_loaded_profile; validate_runtime "$instance"; if service_active "$instance"; then note "Stopping currently managed $instance profile..."; systemctl --user stop "$(service_name "$instance")"; fi; ensure_port_available "$instance"; save_selection "$instance" "$profile"; note "Starting $profile on $instance..."; start=$SECONDS; systemctl --user start "$(service_name "$instance")" || die "failed to start $(service_name "$instance")"; wait_for_api "$instance" "$start"; }
start_locked(){ local instance=$1 profile=$2; with_lock "$instance" start_selected "$instance" "$profile"; }
cmd_start(){ if [[ $# == 1 ]]; then start_locked worker "$1"; elif [[ $# == 2 ]]; then require_instance "$1"; start_locked "$1" "$2"; else die "usage: $PROGRAM start [instance] <profile>"; fi; }
stop_selected(){ systemctl --user stop "$(service_name "$1")"; note "Stopped $1; selected profile is retained."; }
cmd_stop(){ [[ $# -le 1 ]] || die "usage: $PROGRAM stop [instance]"; local i=${1:-worker}; require_instance "$i"; with_lock "$i" stop_selected "$i"; }
restart_selected(){ local i=$1 selected start; selected=$(read_selection "$i") || die "no profile is selected for $i; use: $PROGRAM start $i <profile>"; load_profile "$selected"; validate_loaded_profile; validate_runtime "$i"; service_active "$i" && systemctl --user stop "$(service_name "$i")"; ensure_port_available "$i"; start=$SECONDS; systemctl --user start "$(service_name "$i")" || die "failed to restart $i"; wait_for_api "$i" "$start"; }
cmd_restart(){ [[ $# -le 1 ]] || die "usage: $PROGRAM restart [instance]"; local i=${1:-worker}; require_instance "$i"; with_lock "$i" restart_selected "$i"; }
cmd_logs(){ local i=worker follow= arg; for arg in "$@"; do case $arg in worker|agent) [[ $i == worker && -z $follow ]] || die "usage: $PROGRAM logs [instance] [-f|--follow]"; i=$arg;; -f|--follow) [[ -z $follow ]] || die "usage: $PROGRAM logs [instance] [-f|--follow]"; follow=-f;; *) die "usage: $PROGRAM logs [instance] [-f|--follow]";; esac; done; if [[ -n $follow ]]; then journalctl --user -u "$(service_name "$i")" -f; else journalctl --user -u "$(service_name "$i")" --no-pager; fi; }
cmd_run_selected(){ [[ $# -le 1 ]] || die "internal usage: $PROGRAM run-selected [instance]"; local i=${1:-worker} selected container; local -a args; require_instance "$i"; selected=$(read_selection "$i") || { note "No profile selected for $i; not starting llama-server."; return; }; load_profile "$selected"; validate_loaded_profile; validate_runtime "$i"; container=$(instance_container "$i"); args=(-m "$MODEL_PATH" -ngl "$GPU_LAYERS" -c "$CONTEXT_SIZE" -np "$PARALLEL_SLOTS"); [[ -n $MMPROJ_PATH ]] && args+=(--mmproj "$MMPROJ_PATH"); if [[ -n $SPEC_TYPE ]]; then args+=(--spec-type "$SPEC_TYPE"); [[ -n $DRAFT_MODEL_PATH ]] && args+=(--spec-draft-model "$DRAFT_MODEL_PATH" --spec-draft-ngl "$DRAFT_GPU_LAYERS"); args+=(--spec-draft-n-max "$SPEC_DRAFT_N_MAX" --spec-draft-p-min "$SPEC_DRAFT_P_MIN"); fi; args+=(--host "$HOST" --port "$(instance_port "$i")"); exec distrobox enter "$container" -- llama-server "${args[@]}"; }
cmd_validate(){ [[ $# == 1 ]] || die "usage: $PROGRAM --validate-profile <profile>"; load_profile "$1"; validate_loaded_profile; note "Valid profile: $PROFILE_NAME"; }
cmd_validate_runtime(){ local instance profile; if [[ $# == 1 ]]; then instance=worker; profile=$1; elif [[ $# == 2 ]]; then instance=$1; profile=$2; require_instance "$instance"; else die "usage: $PROGRAM --validate-runtime [instance] <profile>"; fi; load_profile "$profile"; validate_loaded_profile; validate_runtime "$instance"; note "Runtime available for $instance: $(instance_container "$instance")"; }
cmd_check_port(){ local i profile; if [[ $# == 1 ]]; then i=worker; profile=$1; elif [[ $# == 2 ]]; then i=$1; profile=$2; require_instance "$i"; else die "usage: $PROGRAM --check-port [instance] <profile>"; fi; load_profile "$profile"; validate_loaded_profile; ensure_port_available "$i"; note "Port available for $i: $(instance_port "$i")"; }
case ${1:-help} in list) shift; (($#==0)) || die "usage: $PROGRAM list"; cmd_list;; status) shift; cmd_status "$@";; start) shift; cmd_start "$@";; stop) shift; cmd_stop "$@";; restart) shift; cmd_restart "$@";; logs) shift; cmd_logs "$@";; --validate-profile) shift; cmd_validate "$@";; --validate-runtime) shift; cmd_validate_runtime "$@";; --check-port) shift; cmd_check_port "$@";; run-selected) shift; cmd_run_selected "$@";; help|--help|-h) usage;; *) die "unknown command: $1 (try: $PROGRAM help)";; esac
