#!/usr/bin/env bash
# Local, single-profile model manager for llama.cpp.  Intended to be installed
# as ~/.local/bin/evo-model with profiles in
# ~/.local/share/evo-model/models/.

set -euo pipefail

readonly PROGRAM="evo-model"
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly INSTALLED_PROFILE_DIR="$HOME/.local/share/evo-model/models"
readonly REPOSITORY_PROFILE_DIR="$SCRIPT_DIR/../config/models"
if [[ -n ${EVO_MODEL_PROFILE_DIR+x} ]]; then
  PROFILE_DIR="$EVO_MODEL_PROFILE_DIR"
elif [[ -d "$INSTALLED_PROFILE_DIR" ]]; then
  PROFILE_DIR="$INSTALLED_PROFILE_DIR"
elif [[ -d "$REPOSITORY_PROFILE_DIR" ]]; then
  PROFILE_DIR="$REPOSITORY_PROFILE_DIR"
else
  # An installed script can still show help before profiles are installed.
  PROFILE_DIR="$INSTALLED_PROFILE_DIR"
fi
readonly PROFILE_DIR
readonly STATE_DIR="${EVO_MODEL_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/evo-model}"
readonly SELECTION_FILE="$STATE_DIR/selected-profile"
readonly SERVICE_NAME="${EVO_MODEL_SERVICE_NAME:-evo-model.service}"
readonly HEALTH_TIMEOUT="${EVO_MODEL_HEALTH_TIMEOUT:-180}"

die() { printf '%s: %s\n' "$PROGRAM" "$*" >&2; exit 1; }
note() { printf '%s\n' "$*"; }

usage() {
  cat <<'EOF'
Usage: evo-model <command> [arguments]

Commands:
  list                 List available profiles.
  status               Show the selected profile and managed service state.
  start <profile>      Select, start, and wait for a profile's API.
  stop                 Stop the managed service; retain the selection.
  restart              Restart the selected profile and wait for its API.
  logs [-f|--follow]   Show service logs (follow only when requested).
  help                 Show this help.

Only evo-model.service is managed. Existing llama-server services are untouched.
EOF
}

valid_key() {
  case "$1" in
    PROFILE_NAME|MODEL_PATH|BACKEND|CONTAINER|CONTEXT_SIZE|GPU_LAYERS|PARALLEL_SLOTS|SPEC_TYPE|DRAFT_MODEL_PATH|DRAFT_GPU_LAYERS|MMPROJ_PATH|SPEC_DRAFT_N_MAX|SPEC_DRAFT_P_MIN|HOST|PORT) return 0 ;;
    *) return 1 ;;
  esac
}

reset_profile() {
  PROFILE_NAME= MODEL_PATH= BACKEND= CONTAINER= CONTEXT_SIZE= GPU_LAYERS=
  PARALLEL_SLOTS= SPEC_TYPE= DRAFT_MODEL_PATH= DRAFT_GPU_LAYERS= MMPROJ_PATH=
  SPEC_DRAFT_N_MAX= SPEC_DRAFT_P_MIN= HOST= PORT=
}

profile_path() {
  local profile=$1
  [[ "$profile" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid profile name: $profile"
  printf '%s/%s.conf\n' "$PROFILE_DIR" "$profile"
}

load_profile() {
  local profile=$1 file line key value line_number=0
  file=$(profile_path "$profile")
  [[ -f "$file" ]] || die "profile not found: $profile"
  reset_profile

  while IFS= read -r line || [[ -n "$line" ]]; do
    line_number=$((line_number + 1))
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *=* ]] || die "$file:$line_number: expected KEY=VALUE"
    key=${line%%=*}
    value=${line#*=}
    valid_key "$key" || die "$file:$line_number: unsupported key: $key"
    [[ -n "$value" ]] || die "$file:$line_number: empty value for $key"
    [[ ! "$value" =~ [[:cntrl:]] ]] || die "$file:$line_number: invalid control character"
    [[ -z ${!key+x} || -z ${!key} ]] || die "$file:$line_number: duplicate key: $key"
    printf -v "$key" '%s' "$value"
  done < "$file"

  [[ "$PROFILE_NAME" == "$profile" ]] || die "$file: PROFILE_NAME must equal filename ($profile)"
}

is_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }
is_decimal_0_1() { [[ "$1" =~ ^(0|1|0\.[0-9]+|1\.0+)$ ]]; }
is_host() { [[ "$1" =~ ^[A-Za-z0-9.:_-]+$ ]]; }

validate_loaded_profile() {
  local required
  for required in PROFILE_NAME MODEL_PATH BACKEND CONTAINER CONTEXT_SIZE GPU_LAYERS PARALLEL_SLOTS SPEC_DRAFT_N_MAX SPEC_DRAFT_P_MIN HOST PORT; do
    [[ -n ${!required} ]] || die "profile $PROFILE_NAME: missing required key $required"
  done
  [[ "$MODEL_PATH" = /* ]] || die "profile $PROFILE_NAME: MODEL_PATH must be absolute"
  [[ -f "$MODEL_PATH" ]] || die "profile $PROFILE_NAME: model not found: $MODEL_PATH"
  if [[ -n "$MMPROJ_PATH" ]]; then
    [[ "$MMPROJ_PATH" = /* ]] || die "profile $PROFILE_NAME: MMPROJ_PATH must be absolute"
    [[ -f "$MMPROJ_PATH" ]] || die "profile $PROFILE_NAME: multimodal projector not found: $MMPROJ_PATH"
  fi
  if [[ -n "$DRAFT_MODEL_PATH" || -n "$DRAFT_GPU_LAYERS" ]]; then
    [[ -n "$DRAFT_MODEL_PATH" && -n "$DRAFT_GPU_LAYERS" ]] || die "profile $PROFILE_NAME: DRAFT_MODEL_PATH and DRAFT_GPU_LAYERS must be defined together"
    [[ -n "$SPEC_TYPE" ]] || die "profile $PROFILE_NAME: DRAFT_MODEL_PATH requires SPEC_TYPE"
    [[ "$DRAFT_MODEL_PATH" = /* ]] || die "profile $PROFILE_NAME: DRAFT_MODEL_PATH must be absolute"
    [[ -f "$DRAFT_MODEL_PATH" ]] || die "profile $PROFILE_NAME: draft model not found: $DRAFT_MODEL_PATH"
    is_uint "$DRAFT_GPU_LAYERS" || die "profile $PROFILE_NAME: DRAFT_GPU_LAYERS must be a non-negative integer"
  fi
  [[ "$CONTAINER" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "profile $PROFILE_NAME: invalid CONTAINER"
  is_uint "$CONTEXT_SIZE" && [[ "$CONTEXT_SIZE" -gt 0 ]] || die "profile $PROFILE_NAME: CONTEXT_SIZE must be a positive integer"
  is_uint "$GPU_LAYERS" || die "profile $PROFILE_NAME: GPU_LAYERS must be a non-negative integer"
  is_uint "$PARALLEL_SLOTS" && [[ "$PARALLEL_SLOTS" -gt 0 ]] || die "profile $PROFILE_NAME: PARALLEL_SLOTS must be a positive integer"
  [[ -z "$SPEC_TYPE" || "$SPEC_TYPE" =~ ^[A-Za-z0-9_-]+$ ]] || die "profile $PROFILE_NAME: invalid SPEC_TYPE"
  is_uint "$SPEC_DRAFT_N_MAX" || die "profile $PROFILE_NAME: SPEC_DRAFT_N_MAX must be a non-negative integer"
  is_decimal_0_1 "$SPEC_DRAFT_P_MIN" || die "profile $PROFILE_NAME: SPEC_DRAFT_P_MIN must be between 0 and 1"
  is_host "$HOST" || die "profile $PROFILE_NAME: invalid HOST"
  is_uint "$PORT" && [[ "$PORT" -ge 1 && "$PORT" -le 65535 ]] || die "profile $PROFILE_NAME: PORT must be 1-65535"
}

validate_runtime() {
  command -v distrobox >/dev/null 2>&1 || die "distrobox is not available"
  distrobox list --no-color 2>/dev/null | awk -F '|' -v container="$CONTAINER" '
    function trim(value) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); return value }
    {
      name = trim($2)
      if (name == "NAME") next
      if (name == container) found = 1
    }
    END { exit !found }
  ' \
    || die "profile $PROFILE_NAME: Distrobox container not found: $CONTAINER"
}

read_selection() {
  [[ -f "$SELECTION_FILE" ]] || return 1
  local selected
  IFS= read -r selected < "$SELECTION_FILE" || return 1
  [[ "$selected" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid saved selected profile"
  printf '%s\n' "$selected"
}

save_selection() {
  mkdir -p "$STATE_DIR"
  umask 077
  printf '%s\n' "$1" > "$SELECTION_FILE"
}

service_active() { systemctl --user is-active --quiet "$SERVICE_NAME"; }

api_url() { printf 'http://127.0.0.1:%s/v1/models\n' "$PORT"; }

ensure_port_available() {
  local listeners
  command -v ss >/dev/null 2>&1 || die "ss is required to check whether port $PORT is available"
  if ! listeners=$(ss -ltnH "sport = :$PORT"); then
    die "could not inspect port $PORT with ss"
  fi
  if awk -v port="$PORT" '$4 ~ (":" port "$") { found = 1 } END { exit !found }' <<<"$listeners"; then
    die "port $PORT is already in use; stop the conflicting service or select a different profile"
  fi
}

api_matches_profile() {
  local response model_name
  response=$(curl --fail --silent --max-time 5 "$(api_url)" 2>/dev/null) || return 1
  model_name=${MODEL_PATH##*/}
  [[ "$response" == *"\"$MODEL_PATH\""* || "$response" == *"\"$model_name\""* ]]
}

api_is_ready() {
  service_active || return 1
  api_matches_profile || return 1
  # A successful HTTP response is not sufficient if the managed process exited
  # while the request was being made.
  service_active
}

wait_for_api() {
  local start_time=$1 deadline=$((SECONDS + HEALTH_TIMEOUT)) elapsed
  note "Loading $PROFILE_NAME..."
  while (( SECONDS < deadline )); do
    if ! service_active; then
      printf '%s\n' "Service failed before the API became ready. Inspect with: $PROGRAM logs" >&2
      return 1
    fi
    if api_is_ready; then
      elapsed=$((SECONDS - start_time))
      note "Model loaded in ${elapsed}s"
      note "API ready: $(api_url)"
      return 0
    fi
    if ! service_active; then
      printf '%s\n' "Service failed before the API became ready. Inspect with: $PROGRAM logs" >&2
      return 1
    fi
    sleep 2
    elapsed=$((SECONDS - start_time))
    note "Waiting for API... ${elapsed}s"
  done
  elapsed=$((SECONDS - start_time))
  printf '%s\n' "Model did not become ready after ${elapsed}s. Inspect with: $PROGRAM logs" >&2
  return 1
}

with_lock() {
  command -v flock >/dev/null 2>&1 || die "flock is required to serialize model changes"
  mkdir -p "$STATE_DIR"
  exec 9>"$STATE_DIR/manager.lock"
  flock -n 9 || die "another evo-model operation is in progress"
  "$@"
}

cmd_list() {
  local file profile selected="" active=""
  selected=$(read_selection || true)
  service_active && active=$selected || true
  shopt -s nullglob
  for file in "$PROFILE_DIR"/*.conf; do
    profile=${file##*/}; profile=${profile%.conf}
    if [[ "$profile" == "$selected" && -n "$active" ]]; then
      printf '%-24s selected, active\n' "$profile"
    elif [[ "$profile" == "$selected" ]]; then
      printf '%-24s selected\n' "$profile"
    else
      printf '%s\n' "$profile"
    fi
  done
}

cmd_status() {
  local selected service_state api_state="not ready" pid="-" draft_name mmproj_name
  selected=$(read_selection || true)
  if [[ -z "$selected" ]]; then
    service_state=$(systemctl --user is-active "$SERVICE_NAME" 2>/dev/null || true)
    [[ -n "$service_state" ]] || service_state="unknown"
    note "Profile: (none selected)"
    note "Service: $service_state"
    note "API: not applicable"
    return 0
  fi
  load_profile "$selected"
  validate_loaded_profile
  service_state=$(systemctl --user is-active "$SERVICE_NAME" 2>/dev/null || true)
  [[ -n "$service_state" ]] || service_state="unknown"
  if api_is_ready; then api_state="ready"; fi
  pid=$(systemctl --user show --property=MainPID --value "$SERVICE_NAME" 2>/dev/null || true)
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || pid="-"
  cat <<EOF
Profile: $PROFILE_NAME
Service: $service_state
API: $api_state
Backend: $BACKEND
Container: $CONTAINER
Model: $MODEL_PATH
EOF
  if [[ -n "$DRAFT_MODEL_PATH" ]]; then
    draft_name=${DRAFT_MODEL_PATH##*/}
    printf 'Draft model: %s\n' "$draft_name"
  fi
  if [[ -n "$MMPROJ_PATH" ]]; then
    mmproj_name=${MMPROJ_PATH##*/}
    printf 'MMProj: %s\n' "$mmproj_name"
  fi
  cat <<EOF
Context: $CONTEXT_SIZE
Host: $HOST
Port: $PORT
Listen: $HOST:$PORT
Health endpoint: $(api_url)
PID: $pid
EOF
}

start_selected() {
  local profile=$1 start_time
  load_profile "$profile"
  validate_loaded_profile
  validate_runtime
  if service_active; then
    note "Stopping the currently managed profile..."
    systemctl --user stop "$SERVICE_NAME"
  fi
  ensure_port_available
  save_selection "$profile"
  note "Starting $profile..."
  start_time=$SECONDS
  if ! systemctl --user start "$SERVICE_NAME"; then
    die "failed to start $SERVICE_NAME; inspect with: $PROGRAM logs"
  fi
  wait_for_api "$start_time"
}

cmd_start() { [[ $# -eq 1 ]] || die "usage: $PROGRAM start <profile>"; with_lock start_selected "$1"; }
cmd_stop() { [[ $# -eq 0 ]] || die "usage: $PROGRAM stop"; with_lock systemctl --user stop "$SERVICE_NAME"; note "Stopped managed service; selected profile is retained."; }
restart_selected() {
  local selected start_time
  selected=$(read_selection) || die "no profile is selected; use: $PROGRAM start <profile>"
  load_profile "$selected"; validate_loaded_profile; validate_runtime
  note "Restarting $selected..."
  if service_active && ! systemctl --user stop "$SERVICE_NAME"; then
    die "failed to stop $SERVICE_NAME before restart; inspect with: $PROGRAM logs"
  fi
  ensure_port_available
  start_time=$SECONDS
  if ! systemctl --user start "$SERVICE_NAME"; then
    die "failed to restart $SERVICE_NAME; inspect with: $PROGRAM logs"
  fi
  wait_for_api "$start_time"
}
cmd_restart() { [[ $# -eq 0 ]] || die "usage: $PROGRAM restart"; with_lock restart_selected; }
cmd_logs() { [[ $# -le 1 ]] || die "usage: $PROGRAM logs [-f|--follow]"; case "${1:-}" in '') journalctl --user -u "$SERVICE_NAME" --no-pager ;; -f|--follow) journalctl --user -u "$SERVICE_NAME" -f ;; *) die "usage: $PROGRAM logs [-f|--follow]" ;; esac; }

# Called only by evo-model.service. An empty selection exits successfully so
# Restart=on-failure cannot loop when the manager has never selected a model.
cmd_run_selected() {
  [[ $# -eq 0 ]] || die "internal command takes no arguments"
  local selected
  local -a server_args
  selected=$(read_selection) || { note "No profile selected; not starting llama-server."; return 0; }
  load_profile "$selected"; validate_loaded_profile; validate_runtime
  server_args=(
    -m "$MODEL_PATH" -ngl "$GPU_LAYERS" -c "$CONTEXT_SIZE" -np "$PARALLEL_SLOTS"
  )
  [[ -n "$MMPROJ_PATH" ]] && server_args+=(--mmproj "$MMPROJ_PATH")
  if [[ -n "$SPEC_TYPE" ]]; then
    server_args+=(--spec-type "$SPEC_TYPE")
    if [[ -n "$DRAFT_MODEL_PATH" ]]; then
      server_args+=(--spec-draft-model "$DRAFT_MODEL_PATH" --spec-draft-ngl "$DRAFT_GPU_LAYERS")
    fi
    server_args+=(--spec-draft-n-max "$SPEC_DRAFT_N_MAX" --spec-draft-p-min "$SPEC_DRAFT_P_MIN")
  fi
  server_args+=(--host "$HOST" --port "$PORT")
  exec distrobox enter "$CONTAINER" -- llama-server "${server_args[@]}"
}

cmd_validate() { [[ $# -eq 1 ]] || die "usage: $PROGRAM --validate-profile <profile>"; load_profile "$1"; validate_loaded_profile; note "Valid profile: $PROFILE_NAME"; }
cmd_validate_runtime() { [[ $# -eq 1 ]] || die "usage: $PROGRAM --validate-runtime <profile>"; load_profile "$1"; validate_loaded_profile; validate_runtime; note "Runtime available: $CONTAINER"; }
cmd_check_port() { [[ $# -eq 1 ]] || die "usage: $PROGRAM --check-port <profile>"; load_profile "$1"; validate_loaded_profile; ensure_port_available; note "Port available: $PORT"; }

case "${1:-help}" in
  list) shift; cmd_list "$@" ;; status) shift; cmd_status "$@" ;;
  start) shift; cmd_start "$@" ;; stop) shift; cmd_stop "$@" ;;
  restart) shift; cmd_restart "$@" ;; logs) shift; cmd_logs "$@" ;;
  --validate-profile) shift; cmd_validate "$@" ;;
  --validate-runtime) shift; cmd_validate_runtime "$@" ;;
  --check-port) shift; cmd_check_port "$@" ;;
  run-selected) shift; cmd_run_selected "$@" ;;
  help|--help|-h) usage ;;
  *) die "unknown command: $1 (try: $PROGRAM help)" ;;
esac
