#!/usr/bin/env bash
# Local named-instance model manager for llama.cpp and Gufo.
set -euo pipefail

readonly PROGRAM=evo-model
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly INSTALLED_PROFILE_DIR="$HOME/.local/share/evo-model/models"
readonly REPOSITORY_PROFILE_DIR="$SCRIPT_DIR/../config/models"
if [[ -n ${EVO_MODEL_PROFILE_DIR+x} ]]; then
  PROFILE_DIR=$EVO_MODEL_PROFILE_DIR
elif [[ -d $INSTALLED_PROFILE_DIR ]]; then
  PROFILE_DIR=$INSTALLED_PROFILE_DIR
elif [[ -d $REPOSITORY_PROFILE_DIR ]]; then
  PROFILE_DIR=$REPOSITORY_PROFILE_DIR
else
  PROFILE_DIR=$INSTALLED_PROFILE_DIR
fi
readonly PROFILE_DIR
readonly STATE_DIR="${EVO_MODEL_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/evo-model}"
readonly LEGACY_SELECTION_FILE="$STATE_DIR/selected-profile"
readonly HEALTH_TIMEOUT="${EVO_MODEL_HEALTH_TIMEOUT:-180}"

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

note() {
  printf '%s\n' "$*"
}

usage() {
  cat <<'EOF'
Usage: evo-model <command> [arguments]

Instances: worker, agent, or a profile name. PORT comes from the profile.
  list
  status [instance] [--json]
  start [instance] <profile>
  stop [instance]
  restart [instance]
  logs [instance] [-f|--follow]
  --validate-profile <profile>
  --validate-runtime [instance] <profile>
  --check-port [instance] <profile>

start <profile> creates an instance named <profile>, for every backend.
Commands without an instance default to worker (status lists all instances).
Only evo-model@.service instances are managed.
EOF
}

valid_instance() {
  [[ $1 =~ ^[a-z0-9][a-z0-9-]*$ && ${#1} -le 128 ]]
}

require_instance() {
  valid_instance "$1" || die "invalid instance: $1 (expected lowercase letters, digits and hyphens)"
}

instance_port() {
  if [[ -n ${PORT:-} ]]; then
    printf '%s\n' "$PORT"
  else
    case $1 in worker) echo 8080;; agent) echo 8081;; *) echo 0;; esac
  fi
}

known_instance() {
  require_instance "$1"
  [[ $1 == worker || $1 == agent || -f $(selection_file "$1") ]] ||
    die "instance not created: $1; use: $PROGRAM start $1 <profile>"
}

all_instances() {
  local file instance
  printf 'worker\nagent\n'
  for file in "$STATE_DIR"/*/selected-profile; do
    [[ -f $file ]] || continue
    instance=${file%/selected-profile}; instance=${instance##*/}
    [[ $instance == worker || $instance == agent ]] && continue
    valid_instance "$instance" && printf '%s\n' "$instance"
  done
  return 0
}

instance_container() {
  case $1 in
    worker) printf 'llama-vulkan-worker\n' ;;
    agent) printf 'llama-vulkan-radv\n' ;;
    *) printf '%s\n' "${CONTAINER:-}" ;;
  esac
}

selection_file() {
  printf '%s/%s/selected-profile\n' "$STATE_DIR" "$1"
}

service_name() {
  printf 'evo-model@%s.service\n' "$1"
}

valid_key(){ case $1 in PROFILE_NAME|MODEL_PATH|BACKEND|CONTAINER|CONTEXT_SIZE|GPU_LAYERS|PARALLEL_SLOTS|SPEC_TYPE|DRAFT_MODEL_PATH|DRAFT_GPU_LAYERS|MMPROJ_PATH|FLASH_ATTN|BATCH_SIZE|UBATCH_SIZE|CACHE_TYPE_K|CACHE_TYPE_V|LAZY_MODE|JINJA|REASONING|REASONING_PRESERVE|RUNTIME_CONTAINER|SERVER_PATH|SPEC_DRAFT_ADAPTIVE|SPEC_DRAFT_N_MIN|SPEC_DRAFT_N_MAX|SPEC_DRAFT_P_MIN|HIP_LAUNCH_BLOCKING|HOST|PORT|GUFO_IMAGE|CONTAINER_PORT|SESSIONS) return;; *) return 1;; esac; }
reset_profile(){ PROFILE_NAME= MODEL_PATH= BACKEND= CONTAINER= CONTEXT_SIZE= GPU_LAYERS= PARALLEL_SLOTS= SPEC_TYPE= DRAFT_MODEL_PATH= DRAFT_GPU_LAYERS= MMPROJ_PATH= FLASH_ATTN= BATCH_SIZE= UBATCH_SIZE= CACHE_TYPE_K= CACHE_TYPE_V= LAZY_MODE= JINJA= REASONING= REASONING_PRESERVE= RUNTIME_CONTAINER= SERVER_PATH= SPEC_DRAFT_ADAPTIVE= SPEC_DRAFT_N_MIN= SPEC_DRAFT_N_MAX= SPEC_DRAFT_P_MIN= HIP_LAUNCH_BLOCKING= HOST= PORT= GUFO_IMAGE= CONTAINER_PORT= SESSIONS=; }
profile_path(){ [[ $1 =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid profile name: $1"; printf '%s/%s.conf\n' "$PROFILE_DIR" "$1"; }
load_profile(){ local profile=$1 file line key value n=0; file=$(profile_path "$profile"); [[ -f $file ]] || die "profile not found: $profile"; reset_profile; while IFS= read -r line || [[ -n $line ]]; do n=$((n+1)); [[ -z $line || $line == \#* ]] && continue; [[ $line == *=* ]] || die "$file:$n: expected KEY=VALUE"; key=${line%%=*}; value=${line#*=}; valid_key "$key" || die "$file:$n: unsupported key: $key"; [[ -n $value && ! $value =~ [[:cntrl:]] ]] || die "$file:$n: invalid or empty value"; [[ -z ${!key+x} || -z ${!key} ]] || die "$file:$n: duplicate key: $key"; printf -v "$key" '%s' "$value"; done < "$file"; [[ $PROFILE_NAME == "$profile" ]] || die "$file: PROFILE_NAME must equal filename ($profile)"; }
is_uint(){ [[ $1 =~ ^[0-9]+$ ]]; }; is_decimal_0_1(){ [[ $1 =~ ^(0|1|0\.[0-9]+|1\.0+)$ ]]; }; is_host(){ [[ $1 =~ ^[A-Za-z0-9.:_-]+$ ]]; }
validate_loaded_profile(){ local key; if [[ $BACKEND == gufo ]]; then validate_gufo_profile; return; fi; case $BACKEND in ROCm|Vulkan|RADV/Vulkan|llama.cpp) ;; *) die "unsupported BACKEND: $BACKEND";; esac; [[ -z $GUFO_IMAGE && -z $CONTAINER_PORT && -z $SESSIONS ]] || die "Gufo settings require BACKEND=gufo"; for key in PROFILE_NAME MODEL_PATH BACKEND CONTAINER CONTEXT_SIZE GPU_LAYERS PARALLEL_SLOTS HOST PORT; do [[ -n ${!key} ]] || die "profile $PROFILE_NAME: missing required key $key"; done; [[ $MODEL_PATH = /* && -f $MODEL_PATH ]] || die "profile $PROFILE_NAME: model not found or not absolute: $MODEL_PATH"; [[ -z $MMPROJ_PATH || ( $MMPROJ_PATH = /* && -f $MMPROJ_PATH ) ]] || die "profile $PROFILE_NAME: multimodal projector not found or not absolute: $MMPROJ_PATH"; if [[ -n $DRAFT_MODEL_PATH || -n $DRAFT_GPU_LAYERS ]]; then [[ -n $DRAFT_MODEL_PATH && -n $SPEC_TYPE && $DRAFT_MODEL_PATH = /* && -f $DRAFT_MODEL_PATH ]] || die "profile $PROFILE_NAME: invalid external draft"; [[ -z $DRAFT_GPU_LAYERS ]] || is_uint "$DRAFT_GPU_LAYERS" || die "profile $PROFILE_NAME: DRAFT_GPU_LAYERS must be a non-negative integer"; fi; [[ $CONTAINER =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "profile $PROFILE_NAME: invalid CONTAINER"; is_uint "$CONTEXT_SIZE" && [[ $CONTEXT_SIZE -gt 0 ]] || die "profile $PROFILE_NAME: invalid CONTEXT_SIZE"; is_uint "$GPU_LAYERS" || die "profile $PROFILE_NAME: invalid GPU_LAYERS"; is_uint "$PARALLEL_SLOTS" && [[ $PARALLEL_SLOTS -gt 0 ]] || die "profile $PROFILE_NAME: invalid PARALLEL_SLOTS"; [[ -z $SPEC_TYPE || $SPEC_TYPE =~ ^[A-Za-z0-9_-]+$ ]] || die "profile $PROFILE_NAME: invalid SPEC_TYPE"; validate_optional_settings; is_host "$HOST" && is_uint "$PORT" && [[ $PORT -ge 1 && $PORT -le 65535 ]] || die "profile $PROFILE_NAME: invalid numeric, host, or port setting"; }
# Gufo has its own schema: llama.cpp-only options must not be silently ignored.
validate_gufo_profile() {
  local key
  for key in PROFILE_NAME MODEL_PATH BACKEND CONTEXT_SIZE HOST PORT GUFO_IMAGE CONTAINER_PORT SESSIONS; do
    [[ -n ${!key} ]] || die "profile $PROFILE_NAME: missing required key $key"
  done
  [[ $MODEL_PATH == /* && -f $MODEL_PATH ]] || die "profile $PROFILE_NAME: model not found or not absolute: $MODEL_PATH"
  for key in CONTEXT_SIZE SESSIONS PORT CONTAINER_PORT; do
    [[ ${!key} =~ ^[1-9][0-9]{0,8}$ ]] || die "profile $PROFILE_NAME: invalid $key"
  done
  ((PORT <= 65535 && CONTAINER_PORT <= 65535)) || die "invalid port"
  is_host "$HOST" || die "invalid HOST"
  [[ $GUFO_IMAGE =~ ^[A-Za-z0-9][A-Za-z0-9./:@_-]+$ ]] || die "invalid GUFO_IMAGE"
  case $SPEC_TYPE in
    '') [[ -z $DRAFT_MODEL_PATH ]] || die "DRAFT_MODEL_PATH requires SPEC_TYPE=mtp";;
    mtp) [[ $DRAFT_MODEL_PATH == /* && -f $DRAFT_MODEL_PATH ]] || die "MTP model not found or not absolute";;
    *) die "Gufo supports SPEC_TYPE=mtp or no speculative setting";;
  esac
  # Colons cannot be represented safely by Podman's volume syntax.
  [[ $MODEL_PATH != *:* && $DRAFT_MODEL_PATH != *:* ]] || die "Gufo model paths cannot contain colons"
  for key in CONTAINER RUNTIME_CONTAINER SERVER_PATH GPU_LAYERS PARALLEL_SLOTS DRAFT_GPU_LAYERS MMPROJ_PATH FLASH_ATTN BATCH_SIZE UBATCH_SIZE CACHE_TYPE_K CACHE_TYPE_V LAZY_MODE JINJA REASONING REASONING_PRESERVE SPEC_DRAFT_ADAPTIVE SPEC_DRAFT_N_MIN SPEC_DRAFT_N_MAX SPEC_DRAFT_P_MIN HIP_LAUNCH_BLOCKING; do
    [[ -z ${!key} ]] || die "profile $PROFILE_NAME: $key is not supported by Gufo"
  done
}

validate_gufo_runtime() {
  command -v podman >/dev/null || die "podman is required for Gufo"
  command -v python3 >/dev/null || die "python3 is required for Gufo API validation"
  [[ $(podman info --format '{{.Host.Security.Rootless}}') == true ]] || die "Gufo requires rootless Podman"
  podman image exists "$GUFO_IMAGE" || die "Gufo image is not available locally: $GUFO_IMAGE"
}

# A random ownership token is persisted BEFORE container creation. Discovery by
# this token covers interruption before Podman writes the cidfile. Never remove
# containers by name or by a broad backend/instance label.
gufo_ids() {
  local instance=$1 token
  [[ -f $STATE_DIR/$instance/gufo-owner ]] || return 0
  IFS= read -r token < "$STATE_DIR/$instance/gufo-owner" || return 1
  [[ $token =~ ^[a-f0-9-]{36}$ ]] || { echo "Invalid Gufo ownership record" >&2; return 1; }
  podman ps --all --quiet --no-trunc --filter "label=org.evo-model.owner=$token" \
    --filter "label=org.evo-model.instance=$instance"
}

container_exists() {
  local rc
  if podman container exists "$1"; then return 0; else rc=$?; fi
  [[ $rc == 1 ]] && return 1
  die "cannot determine whether container $1 exists (podman exit $rc)"
}

cleanup_runtime() (
  local instance=$1 ids cid token owner
  [[ -f $STATE_DIR/$instance/gufo-owner ]] || return 0
  exec 7>"$STATE_DIR/$instance/cleanup.lock"
  flock 7
  [[ -f $STATE_DIR/$instance/gufo-owner ]] || return 0
  IFS= read -r token < "$STATE_DIR/$instance/gufo-owner"
  ids=$(gufo_ids "$instance") || die "cannot inspect Gufo containers for $instance"
  for cid in $ids; do
    [[ $cid =~ ^[a-f0-9]{64}$ ]] || die "invalid container ID returned by Podman"
    container_exists "$cid" || continue
    owner=$(podman inspect --format '{{index .Config.Labels "org.evo-model.owner"}}/{{index .Config.Labels "org.evo-model.instance"}}' "$cid") || {
      container_exists "$cid" || continue
      die "cannot verify ownership of $cid"
    }
    [[ $owner == "$token/$instance" ]] || die "refusing to remove container with mismatched ownership: $cid"
    # --force with a timeout stops the payload, escalating to SIGKILL as needed.
    podman rm --force --time 10 "$cid" >/dev/null || {
      container_exists "$cid" || continue
      die "failed to remove Gufo container $cid"
    }
    if container_exists "$cid"; then die "Gufo container still exists after removal: $cid"; fi
  done
  # Retain the ownership record on any failure, allowing a later stop to retry.
  ids=$(gufo_ids "$instance") || die "cannot verify Gufo cleanup"
  [[ -z $ids ]] || die "Gufo containers remain for $instance"
  rm -f -- "$STATE_DIR/$instance/gufo-owner" "$STATE_DIR/$instance/gufo.cid"
)

gufo_state() {
  local ids cid state
  ids=$(gufo_ids "$1") || { echo unknown; return; }
  [[ -n $ids ]] || { echo absent; return; }
  [[ $ids != *$'\n'* ]] || { echo unknown; return; }
  cid=$ids
  state=$(podman inspect --format '{{.State.Status}}' "$cid" 2>/dev/null) || state=unknown
  printf '%s\n' "$state"
}

run_gufo() {
  local instance=$1 token host=$HOST user_uid user_gid
  local -a command
  user_uid=$(id -u)
  user_gid=$(id -g)
  cleanup_runtime "$instance"
  mkdir -p "$STATE_DIR/$instance"
  umask 077
  token=$(cat /proc/sys/kernel/random/uuid)
  printf '%s\n' "$token" > "$STATE_DIR/$instance/gufo-owner.tmp"
  mv -- "$STATE_DIR/$instance/gufo-owner.tmp" "$STATE_DIR/$instance/gufo-owner"
  [[ $host != *:* ]] || host="[$host]"
  command=(podman run --rm --pull=never --name "$(runtime_container "$instance")"
    --cidfile "$STATE_DIR/$instance/gufo.cid"
    --label "org.evo-model.owner=$token" --label "org.evo-model.instance=$instance"
    "--userns=keep-id:uid=$user_uid,gid=$user_gid" --device /dev/kfd --device /dev/dri
    --group-add keep-groups --ulimit memlock=-1
    -p "$host:$PORT:$CONTAINER_PORT" -v "${MODEL_PATH%/*}:/models:ro")
  # A separate directory mount also supports MTP files outside the main model directory.
  [[ -z $DRAFT_MODEL_PATH || ${DRAFT_MODEL_PATH%/*} == "${MODEL_PATH%/*}" ]] ||
    command+=(-v "${DRAFT_MODEL_PATH%/*}:/mtp:ro")
  command+=("$GUFO_IMAGE" gufo serve --host 0.0.0.0 --port "$CONTAINER_PORT" llm
    --model "/models/${MODEL_PATH##*/}")
  if [[ $SPEC_TYPE == mtp ]]; then
    local draft=/models/${DRAFT_MODEL_PATH##*/}
    [[ ${DRAFT_MODEL_PATH%/*} == "${MODEL_PATH%/*}" ]] || draft=/mtp/${DRAFT_MODEL_PATH##*/}
    command+=(--speculative mtp --mtp-model "$draft")
  fi
  command+=(--sessions "$SESSIONS" --context "$CONTEXT_SIZE")
  exec "${command[@]}"
}

# Optional settings remain absent from argv unless explicitly configured.
validate_optional_settings() {
  local key
  [[ -z $HIP_LAUNCH_BLOCKING || $HIP_LAUNCH_BLOCKING == 0 || $HIP_LAUNCH_BLOCKING == 1 ]] ||
    die "profile $PROFILE_NAME: HIP_LAUNCH_BLOCKING must be 0 or 1"
  [[ -z $SERVER_PATH || $SERVER_PATH == /* ]] ||
    die "profile $PROFILE_NAME: SERVER_PATH must be absolute"
  for key in BATCH_SIZE UBATCH_SIZE; do
    [[ -z ${!key} ]] || { is_uint "${!key}" && [[ ${!key} -gt 0 ]]; } ||
      die "profile $PROFILE_NAME: invalid $key"
  done
  for key in FLASH_ATTN LAZY_MODE JINJA REASONING REASONING_PRESERVE; do
    [[ -z ${!key} || ${!key} == on || ${!key} == off ]] ||
      die "profile $PROFILE_NAME: $key must be on or off"
  done
  for key in CACHE_TYPE_K CACHE_TYPE_V; do
    [[ -z ${!key} ]] && continue
    case ${!key} in
      f32|f16|bf16|q8_0|q4_0|q4_1|iq4_nl|q5_0|q5_1) ;;
      *) die "profile $PROFILE_NAME: unsupported $key" ;;
    esac
  done
  [[ -z $RUNTIME_CONTAINER || $RUNTIME_CONTAINER =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] ||
    die "profile $PROFILE_NAME: invalid RUNTIME_CONTAINER"
  if [[ -n $SPEC_DRAFT_ADAPTIVE || -n $SPEC_DRAFT_N_MIN ]]; then
    [[ -n $SPEC_TYPE ]] || die "profile $PROFILE_NAME: draft options require SPEC_TYPE"
  fi
  [[ -z $SPEC_DRAFT_ADAPTIVE || $SPEC_DRAFT_ADAPTIVE == on || $SPEC_DRAFT_ADAPTIVE == off ]] ||
    die "profile $PROFILE_NAME: SPEC_DRAFT_ADAPTIVE must be on or off"
  if [[ -n $SPEC_DRAFT_N_MIN ]]; then
    is_uint "$SPEC_DRAFT_N_MIN" && is_uint "$SPEC_DRAFT_N_MAX" ||
      die "profile $PROFILE_NAME: draft bounds must be non-negative integers"
    (( 10#$SPEC_DRAFT_N_MIN <= 10#$SPEC_DRAFT_N_MAX )) ||
      die "profile $PROFILE_NAME: SPEC_DRAFT_N_MIN must not exceed SPEC_DRAFT_N_MAX"
  fi
  if [[ -n $SPEC_TYPE || -n $SPEC_DRAFT_N_MAX ]]; then
    is_uint "$SPEC_DRAFT_N_MAX" || die "profile $PROFILE_NAME: invalid SPEC_DRAFT_N_MAX"
  fi
  if [[ -n $SPEC_DRAFT_P_MIN ]]; then
    is_decimal_0_1 "$SPEC_DRAFT_P_MIN" || die "profile $PROFILE_NAME: invalid SPEC_DRAFT_P_MIN"
  fi
}
runtime_container() {
  if [[ ${BACKEND:-} == gufo ]]; then
    printf 'evo-model-gufo-%s\n' "$1"
  elif [[ -n ${RUNTIME_CONTAINER:-} ]]; then
    printf '%s\n' "$RUNTIME_CONTAINER"
  else
    instance_container "$1"
  fi
}
append_optional_args() {
  [[ -z $FLASH_ATTN ]] || args+=(-fa "$FLASH_ATTN")
  [[ -z $BATCH_SIZE ]] || args+=(-b "$BATCH_SIZE")
  [[ -z $UBATCH_SIZE ]] || args+=(-ub "$UBATCH_SIZE")
  [[ -z $CACHE_TYPE_K ]] || args+=(--cache-type-k "$CACHE_TYPE_K")
  [[ -z $CACHE_TYPE_V ]] || args+=(--cache-type-v "$CACHE_TYPE_V")
  [[ -z $LAZY_MODE ]] || args+=(--lazy-mode "$LAZY_MODE")
  case $JINJA in on) args+=(--jinja);; off) args+=(--no-jinja);; esac
  [[ -z $REASONING ]] || args+=(--reasoning "$REASONING")
  case $REASONING_PRESERVE in
    on) args+=(--reasoning-preserve);;
    off) ;;
  esac
}
validate_runtime(){ local instance=$1 container; if [[ $BACKEND == gufo ]]; then validate_gufo_runtime; return; fi; container=$(runtime_container "$instance"); command -v distrobox >/dev/null 2>&1 || die "distrobox is not available"; distrobox list --no-color 2>/dev/null | awk -F '|' -v c="$container" 'function t(v){gsub(/^[[:space:]]+|[[:space:]]+$/, "",v);return v} {if(t($2)==c) found=1} END{exit !found}' || die "instance $instance: Distrobox container not found: $container"; }

migrate_legacy(){ local target selected; target=$(selection_file worker); [[ -f $target || ! -f $LEGACY_SELECTION_FILE ]] && return; IFS= read -r selected < "$LEGACY_SELECTION_FILE" || return; [[ $selected =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid saved selected profile"; mkdir -p "$(dirname "$target")"; umask 077; mv -- "$LEGACY_SELECTION_FILE" "$target"; }
read_selection(){ local instance=$1 selected file; require_instance "$instance"; [[ $instance == worker ]] && migrate_legacy; file=$(selection_file "$instance"); [[ -f $file ]] || return 1; IFS= read -r selected < "$file" || return 1; [[ $selected =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid saved selected profile for $instance"; printf '%s\n' "$selected"; }
save_selection(){ local file; file=$(selection_file "$1"); mkdir -p "$(dirname "$file")"; umask 077; printf '%s\n' "$2" > "$file"; }
service_active(){ systemctl --user is-active --quiet "$(service_name "$1")" >/dev/null; }
api_url(){
  local host=${HOST:-127.0.0.1}
  case $host in 0.0.0.0) host=127.0.0.1;; ::) host='[::1]';; *:*) host="[$host]";; esac
  printf 'http://%s:%s/v1/models\n' "$host" "$(instance_port "$1")"
}
ensure_port_available(){ local instance=$1 port listeners; port=$(instance_port "$instance"); command -v ss >/dev/null 2>&1 || die "ss is required to check whether port $port is available"; listeners=$(ss -ltnH "sport = :$port") || die "could not inspect port $port with ss"; if awk -v p="$port" '$4 ~ (":" p "$"){f=1} END{exit !f}' <<<"$listeners"; then die "port $port is already in use; stop the conflicting service or select a different instance"; fi; }
api_is_ready(){
  local instance=$1 response name http_status
  service_active "$instance" || return
  if [[ $BACKEND == gufo ]]; then
    [[ $(gufo_state "$instance") == running ]] || return 1
    response=$(curl --fail --silent --max-time 5 --write-out '\n%{http_code}' "$(api_url "$instance")" 2>/dev/null) || return
    http_status=${response##*$'\n'}
    [[ $http_status == 200 ]] || return 1
    response=${response%$'\n'*}
    # Gufo exposes a display name, not necessarily a GGUF path or filename.
    python3 -c 'import json,sys
try:
    payload=json.load(sys.stdin)
except ValueError:
    sys.exit(1)
data=payload.get("data") if isinstance(payload, dict) else None
ready=isinstance(data, list) and any(
    isinstance(model, dict) and model.get("object")=="model"
    and isinstance(model.get("id"), str) and bool(model["id"].strip())
    for model in data)
sys.exit(0 if ready else 1)' <<<"$response" || return
    [[ $(gufo_state "$instance") == running ]] || return 1
  else
    response=$(curl --fail --silent --max-time 5 "$(api_url "$instance")" 2>/dev/null) || return
    name=${MODEL_PATH##*/}
    [[ $response == *"\"$MODEL_PATH\""* || $response == *"\"$name\""* ]] || return 1
  fi
  service_active "$instance"
}

wait_for_api(){ local instance=$1 start=$2 deadline=$((SECONDS+HEALTH_TIMEOUT)) elapsed; note "Loading $PROFILE_NAME for $instance..."; while ((SECONDS<deadline)); do service_active "$instance" || { printf 'Service failed before the API became ready. Inspect with: %s logs %s\n' "$PROGRAM" "$instance" >&2; return 1; }; if api_is_ready "$instance"; then elapsed=$((SECONDS-start)); note "Model loaded in ${elapsed}s"; note "API ready: $(api_url "$instance")"; return; fi; sleep 2; note "Waiting for API... $((SECONDS-start))s"; done; printf 'Model did not become ready after %ss. Inspect with: %s logs %s\n' "$((SECONDS-start))" "$PROGRAM" "$instance" >&2; return 1; }
with_lock(){ local instance=$1; shift; command -v flock >/dev/null 2>&1 || die "flock is required to serialize model changes"; mkdir -p "$STATE_DIR/$instance"; exec 9>"$STATE_DIR/$instance/manager.lock"; flock -n 9 || die "another evo-model operation for $instance is in progress"; "$@"; }

cmd_list() {
  local file profile instance selection selected

  shopt -s nullglob

  for file in "$PROFILE_DIR"/*.conf; do
    profile=${file##*/}
    profile=${profile%.conf}
    selection=

    while IFS= read -r instance; do
      selected=$(read_selection "$instance" || true)
      [[ $selected != "$profile" ]] || selection=${selection:+$selection,}$instance
    done < <(all_instances)

    if [[ -n $selection ]]; then
      printf '%-24s selected:%s\n' "$profile" "$selection"
    else
      printf '%s\n' "$profile"
    fi
  done
}
collect_status(){ local instance=$1; reset_profile; STATUS_CONTAINER_STATE= STATUS_SESSIONS=; STATUS_INSTANCE=$instance; STATUS_CONTAINER=$(instance_container "$instance"); STATUS_PROFILE=$(read_selection "$instance" || true); STATUS_SERVICE=$(systemctl --user is-active "$(service_name "$instance")" 2>/dev/null || true); STATUS_SERVICE=${STATUS_SERVICE:-unknown}; STATUS_API=not-applicable; STATUS_BACKEND= STATUS_MODEL= STATUS_DRAFT_MODEL= STATUS_MMPROJ= STATUS_CONTEXT_TOTAL= STATUS_PARALLEL_SLOTS= STATUS_CONTEXT_PER_SLOT= STATUS_HOST= STATUS_PID=; STATUS_PORT=$(instance_port "$instance"); STATUS_LISTEN= STATUS_HEALTH_ENDPOINT=$(api_url "$instance"); [[ -n $STATUS_PROFILE ]] || return 0; load_profile "$STATUS_PROFILE"; validate_loaded_profile; STATUS_PORT=$(instance_port "$instance"); STATUS_HEALTH_ENDPOINT=$(api_url "$instance"); STATUS_API=not-ready; api_is_ready "$instance" && STATUS_API=ready; STATUS_CONTAINER=$(runtime_container "$instance"); STATUS_BACKEND=$BACKEND; STATUS_MODEL=$MODEL_PATH; STATUS_DRAFT_MODEL=$DRAFT_MODEL_PATH; STATUS_MMPROJ=$MMPROJ_PATH; STATUS_CONTEXT_TOTAL=$CONTEXT_SIZE; STATUS_PARALLEL_SLOTS=$PARALLEL_SLOTS; if [[ $BACKEND == gufo ]]; then STATUS_SESSIONS=$SESSIONS; STATUS_CONTEXT_PER_SLOT=; STATUS_CONTAINER_STATE=$(gufo_state "$instance"); else STATUS_CONTEXT_PER_SLOT=$((CONTEXT_SIZE / PARALLEL_SLOTS)); fi; STATUS_HOST=$HOST; STATUS_LISTEN=$HOST:$STATUS_PORT; STATUS_PID=$(systemctl --user show --property=MainPID --value "$(service_name "$instance")" 2>/dev/null || true); [[ $STATUS_PID =~ ^[1-9][0-9]*$ ]] || STATUS_PID=; }
print_status(){ collect_status "$1"; printf 'Instance: %s\nProfile: %s\nService: %s\n' "$STATUS_INSTANCE" "${STATUS_PROFILE:-(none selected)}" "$STATUS_SERVICE"; [[ -n $STATUS_PROFILE ]] || { printf 'API: not applicable\nContainer: %s\n\n' "$STATUS_CONTAINER"; return; }; printf 'API: %s\nBackend: %s\nContainer: %s\nModel: %s\n' "$STATUS_API" "$STATUS_BACKEND" "$STATUS_CONTAINER" "$STATUS_MODEL"; if [[ $STATUS_BACKEND == gufo ]]; then printf 'Container state: %s\nSessions: %s\n' "$STATUS_CONTAINER_STATE" "$STATUS_SESSIONS"; fi; [[ -n $STATUS_DRAFT_MODEL ]] && { local draft=${STATUS_DRAFT_MODEL##*/}; printf 'Draft model: %s\n' "$draft"; }; [[ -n $STATUS_MMPROJ ]] && { local mmproj=${STATUS_MMPROJ##*/}; printf 'MMProj: %s\n' "$mmproj"; }; printf 'Context: %s\n' "$STATUS_CONTEXT_TOTAL"; if [[ $STATUS_BACKEND != gufo ]]; then printf 'Parallel slots: %s\n' "$STATUS_PARALLEL_SLOTS"; fi; printf 'Host: %s\nPort: %s\nListen: %s\nHealth endpoint: %s\nPID: %s\n\n' "$STATUS_HOST" "$STATUS_PORT" "$STATUS_LISTEN" "$STATUS_HEALTH_ENDPOINT" "${STATUS_PID:--}"; }
json_string(){ local value=$1 char escaped= i; for ((i=0; i<${#value}; i++)); do char=${value:i:1}; case $char in '"') escaped+='\\"';; '\\') escaped+='\\\\';; $'\b') escaped+='\\b';; $'\f') escaped+='\\f';; $'\n') escaped+='\\n';; $'\r') escaped+='\\r';; $'\t') escaped+='\\t';; *) escaped+=$char;; esac; done; printf '"%s"' "$escaped"; }
json_value(){ [[ -n $1 ]] && json_string "$1" || printf 'null'; }
json_number_or_null(){ [[ -n $1 ]] && printf '%s' "$1" || printf 'null'; }
print_status_json_instance(){ collect_status "$1"; printf '    '; json_string "$STATUS_INSTANCE"; printf ': {\n'; printf '      "profile": '; json_value "$STATUS_PROFILE"; printf ',\n      "service": '; json_string "$STATUS_SERVICE"; printf ',\n      "api": '; json_string "$STATUS_API"; printf ',\n      "backend": '; json_value "$STATUS_BACKEND"; if [[ $STATUS_BACKEND == gufo ]]; then printf ',\n      "sessions": '; json_number_or_null "$STATUS_SESSIONS"; printf ',\n      "container_state": '; json_value "$STATUS_CONTAINER_STATE"; fi; printf ',\n      "container": '; json_string "$STATUS_CONTAINER"; printf ',\n      "model": '; json_value "$STATUS_MODEL"; printf ',\n      "draft_model": '; json_value "$STATUS_DRAFT_MODEL"; printf ',\n      "mmproj": '; json_value "$STATUS_MMPROJ"; printf ',\n      "context_total": '; json_number_or_null "$STATUS_CONTEXT_TOTAL"; printf ',\n      "parallel_slots": '; json_number_or_null "$STATUS_PARALLEL_SLOTS"; printf ',\n      "context_per_slot": '; json_number_or_null "$STATUS_CONTEXT_PER_SLOT"; printf ',\n      "host": '; json_value "$STATUS_HOST"; printf ',\n      "port": %s,\n' "$STATUS_PORT"; printf '      "listen": '; json_value "$STATUS_LISTEN"; printf ',\n      "health_endpoint": '; json_string "$STATUS_HEALTH_ENDPOINT"; printf ',\n      "pid": '; json_number_or_null "$STATUS_PID"; printf '\n    }'; }
cmd_status(){
  local json= instance= arg first=1
  local -a instances
  for arg in "$@"; do
    case $arg in --json) [[ -z $json ]] || die "duplicate --json"; json=1;;
      *) [[ -z $instance ]] || die "usage: $PROGRAM status [instance] [--json]"; known_instance "$arg"; instance=$arg;;
    esac
  done
  if [[ -n $instance ]]; then instances=("$instance"); else mapfile -t instances < <(all_instances); fi
  [[ -z $json ]] || printf '{\n  "instances": {\n'
  for instance in "${instances[@]}"; do
    if [[ -n $json ]]; then
      ((first)) || printf ',\n'
      print_status_json_instance "$instance"
    else print_status "$instance"; fi
    first=0
  done
  [[ -z $json ]] || printf '\n  }\n}\n'
}

start_selected(){ local instance=$1 profile=$2 start; load_profile "$profile"; validate_loaded_profile; validate_runtime "$instance"; systemctl --user stop "$(service_name "$instance")"; cleanup_runtime "$instance"; ensure_port_available "$instance"; save_selection "$instance" "$profile"; note "Starting $profile on $instance..."; start=$SECONDS; if ! systemctl --user start "$(service_name "$instance")"; then stop_selected "$instance"; die "failed to start $(service_name "$instance")"; fi; if ! wait_for_api "$instance" "$start"; then stop_selected "$instance"; return 1; fi; }
start_locked(){ local instance=$1 profile=$2; with_lock "$instance" start_selected "$instance" "$profile"; }
cmd_start(){ if [[ $# == 1 ]]; then require_instance "$1"; start_locked "$1" "$1"; elif [[ $# == 2 ]]; then require_instance "$1"; start_locked "$1" "$2"; else die "usage: $PROGRAM start [instance] <profile>"; fi; }
stop_selected(){ local rc=0; systemctl --user stop "$(service_name "$1")" || rc=$?; cleanup_runtime "$1"; ((rc == 0)) || die "systemd stop failed for $1 (exit $rc)"; note "Stopped $1; selected profile is retained."; }
cmd_stop(){ [[ $# -le 1 ]] || die "usage: $PROGRAM stop [instance]"; local i=${1:-worker}; known_instance "$i"; with_lock "$i" stop_selected "$i"; }
restart_selected(){ local i=$1 selected start; selected=$(read_selection "$i") || die "no profile is selected for $i; use: $PROGRAM start $i <profile>"; load_profile "$selected"; validate_loaded_profile; validate_runtime "$i"; systemctl --user stop "$(service_name "$i")"; cleanup_runtime "$i"; ensure_port_available "$i"; start=$SECONDS; if ! systemctl --user start "$(service_name "$i")"; then stop_selected "$i"; die "failed to restart $i"; fi; if ! wait_for_api "$i" "$start"; then stop_selected "$i"; return 1; fi; }
cmd_restart(){ [[ $# -le 1 ]] || die "usage: $PROGRAM restart [instance]"; local i=${1:-worker}; known_instance "$i"; with_lock "$i" restart_selected "$i"; }
cmd_logs(){
  local i= follow= arg
  for arg in "$@"; do
    case $arg in -f|--follow) [[ -z $follow ]] || die "duplicate follow flag"; follow=-f;;
      *) [[ -z $i ]] || die "usage: $PROGRAM logs [instance] [-f|--follow]"; known_instance "$arg"; i=$arg;;
    esac
  done
  journalctl --user -u "$(service_name "${i:-worker}")" "${follow:---no-pager}"
}

cmd_run_selected(){ [[ $# -le 1 ]] || die "internal usage: $PROGRAM run-selected [instance]"; local i=${1:-worker} selected container; local -a args; require_instance "$i"; selected=$(read_selection "$i") || { note "No profile selected for $i; not starting llama-server."; return; }; load_profile "$selected"; validate_loaded_profile; validate_runtime "$i"; if [[ $BACKEND == gufo ]]; then run_gufo "$i"; return; fi; container=$(runtime_container "$i"); args=(-m "$MODEL_PATH" -ngl "$GPU_LAYERS" -c "$CONTEXT_SIZE" -np "$PARALLEL_SLOTS"); [[ -n $MMPROJ_PATH ]] && args+=(--mmproj "$MMPROJ_PATH"); if [[ -n $SPEC_TYPE ]]; then args+=(--spec-type "$SPEC_TYPE"); [[ -n $DRAFT_MODEL_PATH ]] && args+=(--spec-draft-model "$DRAFT_MODEL_PATH"); [[ -z $DRAFT_GPU_LAYERS ]] || args+=(--spec-draft-ngl "$DRAFT_GPU_LAYERS"); [[ $SPEC_DRAFT_ADAPTIVE != on ]] || args+=(--spec-draft-adaptive); [[ -z $SPEC_DRAFT_N_MIN ]] || args+=(--spec-draft-n-min "$SPEC_DRAFT_N_MIN"); args+=(--spec-draft-n-max "$SPEC_DRAFT_N_MAX"); [[ -z $SPEC_DRAFT_P_MIN ]] || args+=(--spec-draft-p-min "$SPEC_DRAFT_P_MIN"); fi; append_optional_args; args+=(--host "$HOST" --port "$(instance_port "$i")"); local -a server_command=("${SERVER_PATH:-llama-server}"); [[ -z $HIP_LAUNCH_BLOCKING ]] || server_command=(env "HIP_LAUNCH_BLOCKING=$HIP_LAUNCH_BLOCKING" "${server_command[@]}"); exec distrobox enter "$container" -- "${server_command[@]}" "${args[@]}"; }
cmd_validate(){ [[ $# == 1 ]] || die "usage: $PROGRAM --validate-profile <profile>"; load_profile "$1"; validate_loaded_profile; note "Valid profile: $PROFILE_NAME"; }
cmd_validate_runtime(){ local instance profile; if [[ $# == 1 ]]; then instance=$1; profile=$1; elif [[ $# == 2 ]]; then instance=$1; profile=$2; require_instance "$instance"; else die "usage: $PROGRAM --validate-runtime [instance] <profile>"; fi; load_profile "$profile"; validate_loaded_profile; validate_runtime "$instance"; note "Runtime available for $instance: $(runtime_container "$instance")"; }
cmd_check_port(){ local i profile; if [[ $# == 1 ]]; then i=$1; profile=$1; elif [[ $# == 2 ]]; then i=$1; profile=$2; require_instance "$i"; else die "usage: $PROGRAM --check-port [instance] <profile>"; fi; load_profile "$profile"; validate_loaded_profile; ensure_port_available "$i"; note "Port available for $i: $(instance_port "$i")"; }
case ${1:-help} in list) shift; (($#==0)) || die "usage: $PROGRAM list"; cmd_list;; status) shift; cmd_status "$@";; start) shift; cmd_start "$@";; stop) shift; cmd_stop "$@";; restart) shift; cmd_restart "$@";; logs) shift; cmd_logs "$@";; --validate-profile) shift; cmd_validate "$@";; --validate-runtime) shift; cmd_validate_runtime "$@";; --check-port) shift; cmd_check_port "$@";; run-selected) shift; cmd_run_selected "$@";; cleanup-runtime) shift; [[ $# == 1 ]] || die "cleanup-runtime requires instance"; require_instance "$1"; cleanup_runtime "$1";; help|--help|-h) usage;; *) die "unknown command: $1 (try: $PROGRAM help)";; esac
