[Unit]
Description=EVO Model Manager inference runtime
After=default.target

[Service]
Type=simple
# Installed path; see tools/model-manager/README.md. The manager reads the
# selected profile from ~/.local/state/evo-model/selected-profile.
ExecStart=%h/.local/bin/evo-model run-selected
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
